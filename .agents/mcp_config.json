{
  "mcpServers": {
    "wayland-computer-use": {
      "command": "/home/niklas/Documents/Coding/Hobby/wayland_computer_use_mcp/.venv/bin/python3",
      "args": [
        "-m",
        "wayland_computer_use_mcp.server"
      ],
      "env": {
        "WAYLAND_MCP_DISPLAY_MODE": "live",
        "WAYLAND_MCP_ACCESS_MODE": "window",
        "WAYLAND_MCP_SOURCE_TYPE": "2",
